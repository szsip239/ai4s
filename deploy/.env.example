# ai4s 阶段 0 环境变量。复制为 .env 后填写；.env 已被 gitignore，不得入库。

# --- 必填 ---
# PostgreSQL 口令（axonhub 专用账号 axonhub）
DB_PASSWORD=change-me-strong-db-password

# axonhub 管理面 owner 本地账号（首次初始化时创建；阶段 1 将切换为 飞书 OAuth→Casdoor→OIDC）
AXONHUB_ADMIN_EMAIL=admin@ai4s.local
AXONHUB_ADMIN_PASSWORD=change-me-admin-password
AXONHUB_ADMIN_FIRST_NAME=Admin
AXONHUB_ADMIN_LAST_NAME=User

# --- 二选一：OAuth 订阅上游凭据（JSON 原样一行；没有则留空，bootstrap 自动改用 mock 上游验证链路） ---
# codex：本机 `codex login` 后取 ~/.codex/auth.json 的全部内容
#CODEX_OAUTH_JSON={"tokens":{"access_token":"...","refresh_token":"...","account_id":"..."},"last_refresh":"..."}
# claudecode：本机 claude 登录后取 ~/.claude/.credentials.json 的全部内容
#CLAUDECODE_OAUTH_JSON={"claudeAiOauth":{"accessToken":"...","refreshToken":"...","expiresAt":...}}
