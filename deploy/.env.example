# ai4s 阶段 0 环境变量。复制为 .env 后填写；.env 已被 gitignore，不得入库。

# --- 必填 ---
# PostgreSQL 口令（axonhub 专用账号 axonhub）
DB_PASSWORD=change-me-strong-db-password

# axonhub 管理面 owner 本地账号（首次初始化时创建；阶段 1 将切换为 飞书 OAuth→Casdoor→OIDC）
AXONHUB_ADMIN_EMAIL=admin@ai4s.local
AXONHUB_ADMIN_PASSWORD=change-me-admin-password
AXONHUB_ADMIN_FIRST_NAME=Admin
AXONHUB_ADMIN_LAST_NAME=User

# --- 二选一：OAuth 订阅上游凭据（JSON 原样一行；没有则留空，bootstrap 自动改用 mock 上游验证链路） ---
# codex：本机 `codex login` 后取 ~/.codex/auth.json 的全部内容
#CODEX_OAUTH_JSON={"tokens":{"access_token":"...","refresh_token":"...","account_id":"..."},"last_refresh":"..."}
# claudecode：本机 claude 登录后取 ~/.claude/.credentials.json 的全部内容
#CLAUDECODE_OAUTH_JSON={"claudeAiOauth":{"accessToken":"...","refreshToken":"...","expiresAt":...}}

# --- shim 本地端点共享密钥（issue #139） ---
# /judge-test /feishu-alert /classify 要求请求头 X-Shim-Local-Token 匹配本值；
# 留空=fail-closed 三端点恒 403（DLP 回归/语义层直测脚本、agentgateway extAuthz /classify、
# axonhub webhook /feishu-alert 都依赖——启用路由/告警前必须配置）
# 生成：openssl rand -hex 24（勿含引号/反斜杠/空白——shim 启动渲染进网关 config.yaml 时会拒绝）
# 网关联动：shim 启动把本值渲染进 agentgateway/config.yaml 的 SHIM-LOCAL-TOKEN 标记段，
# 网关 depends_on shim 先渲染后读配置；轮换/改值后须先 `docker compose restart shim`
# 再 `docker compose restart agentgateway`——顺序不可反（反了网关持旧 token 被 403 deny）
#SHIM_LOCAL_TOKEN=

# --- 飞书审批定义（issue #19 提额 / issue #72 新建 Key；FEISHU_APP_ID/FEISHU_APP_SECRET 与 webhook 凭据历史沿用仅记 .env） ---
# 提额审批「ai4s 额度提额申请」approval_code（飞书审批管理后台该定义 URL 可取）
#APPROVAL_QUOTA_CODE=
# 新建 Key 审批「ai4s API Key 申请」approval_code（2026-08-20 经 OpenAPI approval/v4/approvals 创建）
#APPROVAL_KEY_CODE=
# 新建 Key 落点项目（GID，默认 Default 项目；仅当 Key 要落到别的项目时才改，一般不动）
#APPROVAL_KEY_PROJECT_ID=gid://axonhub/Project/1

# --- 控制台 Key 申请通道（issue #79：「我的 Key」页发起 → 管理员审批卡 → 点批执行） ---
# 管理员飞书 open_id（ou_*）：审批卡与「非飞书申请人」的 key 明文都私信到此人；不配置则审批通知降级为群 webhook 文本
#FEISHU_ADMIN_OPEN_ID=
# 审批卡「前往控制台审批」按钮落点（控制台审批页 URL；生产部署改为正式域名）
#KEY_REQUEST_CONSOLE_URL=https://ai4s.example.com/key-requests  # 缺省 http://localhost:3000/key-requests（仅本机可用）
# 待办申请超时秒数（超时自动置 expired 并回执；默认 72h）
#KEY_REQUEST_TTL=259200
# 隔离项目 gid（issue #128 邀请流程：新用户先落隔离项目，首次批准 Key 申请时自动迁出）；
# 未配置则 shim 不做自动迁出（fail-closed，不按项目名解析——项目可改名，名字不是身份）
#QUARANTINE_PROJECT_GID=gid://axonhub/Project/6
