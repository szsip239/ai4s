{
  "schemaVersion": 2,
  "id": "ai4s.dashboard-launcher",
  "version": "1.1.0",
  "title": "AI4S 调用统计",
  "description": "调用、Token 与渠道状态",
  "entry": "index.html",
  "mark": "AI",
  "schemas": {
    "config": { "type": "object", "additionalProperties": false },
    "state": { "type": "object", "additionalProperties": false },
    "data": {
      "type": "object",
      "properties": {
        "main": {
          "type": "object",
          "description": "旧版可选字段用于 Host 原位升级时保留已保存的数据。",
          "properties": {
            "status": { "type": "string", "enum": ["empty", "ok", "error"] },
            "error": { "type": "string", "enum": ["missing", "invalid", "unreadable"] },
            "asOf": { "type": "string" },
            "day": { "type": "string" },
            "today": { "type": "boolean" },
            "stale": { "type": "boolean" },
            "periods": {
              "type": "object",
              "properties": {
                "day": {
                  "type": "object",
                  "properties": {
                    "requests": { "type": "integer", "minimum": 0 },
                    "attempts": { "type": "integer", "minimum": 0 },
                    "failed": { "type": "integer", "minimum": 0 },
                    "input": { "type": "integer", "minimum": 0 },
                    "output": { "type": "integer", "minimum": 0 },
                    "cached": { "type": "integer", "minimum": 0 }
                  },
                  "required": ["requests", "attempts", "failed", "input", "output", "cached"],
                  "additionalProperties": false
                },
                "week": {
                  "type": "object",
                  "properties": {
                    "requests": { "type": "integer", "minimum": 0 },
                    "attempts": { "type": "integer", "minimum": 0 },
                    "failed": { "type": "integer", "minimum": 0 },
                    "input": { "type": "integer", "minimum": 0 },
                    "output": { "type": "integer", "minimum": 0 },
                    "cached": { "type": "integer", "minimum": 0 }
                  },
                  "required": ["requests", "attempts", "failed", "input", "output", "cached"],
                  "additionalProperties": false
                },
                "month": {
                  "type": "object",
                  "properties": {
                    "requests": { "type": "integer", "minimum": 0 },
                    "attempts": { "type": "integer", "minimum": 0 },
                    "failed": { "type": "integer", "minimum": 0 },
                    "input": { "type": "integer", "minimum": 0 },
                    "output": { "type": "integer", "minimum": 0 },
                    "cached": { "type": "integer", "minimum": 0 }
                  },
                  "required": ["requests", "attempts", "failed", "input", "output", "cached"],
                  "additionalProperties": false
                }
              },
              "required": ["day", "week", "month"],
              "additionalProperties": false
            },
            "currency": { "type": "string" },
            "requests": { "type": "integer", "minimum": 0 },
            "cost": { "type": "number" },
            "channelCount": { "type": "integer", "minimum": 0 },
            "availableChannelCount": { "type": "integer", "minimum": 0 },
            "failureRatePct": { "type": "number", "minimum": 0, "maximum": 100 },
            "failingChannels": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "failureRatePct": { "type": "number", "minimum": 0, "maximum": 100 }
                },
                "required": ["name", "failureRatePct"],
                "additionalProperties": false
              }
            },
            "models": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": { "name": { "type": "string" }, "requests": { "type": "integer", "minimum": 0 } },
                "required": ["name", "requests"],
                "additionalProperties": false
              }
            },
            "channels": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "disabled": { "type": "boolean" },
                  "attempts": { "type": "integer", "minimum": 0 },
                  "successRatePct": { "type": "number", "minimum": 0, "maximum": 100 }
                },
                "required": ["name", "disabled", "attempts"],
                "additionalProperties": false
              }
            },
            "anomalies": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": { "name": { "type": "string" }, "reason": { "type": "string" } },
                "required": ["name", "reason"],
                "additionalProperties": false
              }
            },
            "keys": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": { "name": { "type": "string" }, "cost": { "type": "number" } },
                "required": ["name"],
                "additionalProperties": false
              }
            }
          },
          "required": ["status"],
          "additionalProperties": false
        }
      },
      "required": ["main"],
      "additionalProperties": false
    },
    "intents": {
      "refresh": { "type": "object", "additionalProperties": false },
      "mosaic.external-app.open": { "type": "object", "additionalProperties": false }
    }
  },
  "defaults": { "config": {}, "state": {}, "data": { "main": { "status": "empty" } } },
  "summary": {
    "values": [
      { "id": "requests", "label": "调用", "pointer": "/data/main/periods/day/requests", "unit": "次" },
      { "id": "anomalies", "label": "异常渠道", "pointer": "/data/main/anomalies", "unit": "个" }
    ],
    "pending": ["anomalies"],
    "list": { "pointer": "/data/main/anomalies", "title": "/name", "detail": "/reason", "max": 5 },
    "updatedAt": "/data/main/asOf"
  },
  "uiHints": {
    "defaultSize": "tall",
    "preferredSize": { "w": 4, "h": 6 },
    "inspector": {}
  },
  "permissions": { "network": [] }
}
