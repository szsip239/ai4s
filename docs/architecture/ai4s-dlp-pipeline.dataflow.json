    { "id": "f-pg-mask", "from": "pg", "to": "mask", "label": "score < 阈值", "classification": "原文" },
    { "id": "f-mask-pii", "from": "mask", "to": "presidioOpf", "label": "PII /analyze（fail-open）", "classification": "待检文本", "labelDx": -30 },
    { "id": "f-mask-up", "from": "mask", "to": "upstream", "label": "掩码后消息", "classification": "已脱敏", "variant": "emphasis", "fromSide": "top", "toSide": "left", "via": [[745, 200], [880, 200], [880, 157]] },
    { "id": "f-mask-judge", "from": "mask", "to": "judge", "label": "响应定稿后异步判定", "classification": "掩码后文本", "variant": "dashed", "fromSide": "right", "toSide": "left", "via": [[862, 271], [862, 499]], "labelDx": -20 },
    { "id": "f-up-resp", "from": "upstream", "to": "respSide", "label": "模型应答", "classification": "可能含敏感内容", "variant": "emphasis" },
    { "id": "f-resp-block", "from": "respSide", "to": "block451", "label": "应答命中敏感", "classification": "阻断", "variant": "dashed", "fromSide": "right", "toSide": "left", "via": [[1108, 385], [1108, 675], [225, 675], [225, 613]] },
    { "id": "f-judge-log", "from": "judge", "to": "shadowLog", "label": "verdict 落条（不落原文）", "classification": "脱敏元数据", "variant": "dashed" }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "主路径与短路语义",
      "items": [
        "评估顺序即 /request 代码顺序：网关 L1 → 词表/EDM 预检（451）→ 注入规则 → 注入 PG → L1/L2 掩码 → 上游",
        "每层命中即短路：451 优先于掩码改写；L1 掩码命中则 L2（Presidio/OPF）不再触发",
        "每层独立开关：settings.json 热生效（l1/l2/edm/rules/pg/response + l2.opf），关层=整层跳过"
      ]
    },
    {
      "dot": "violet",
      "title": "故障语义",
      "items": [
        "检测链 fail-open：Presidio/OPF/judge/PG 异常或超时 → 放行 + 日志/告警，不拖垮业务",
        "admin 配置面 fail-closed：配置校验失败 400/回滚，不落半改状态",
        "语义 judge 与注入 shadow 只记录 verdict，契约上永不阻断链路"
      ]
    },
    {
      "dot": "amber",
      "title": "观测与边界",
      "items": [
        "shadow_log 落五层判定条（judge/PG/rules/judge_inject/router），巡检线程 30s 消费 → 飞书告警",
        "敏感原文不出检测链：掩码先行、日志不落原文、judge 外发输入为掩码后文本",
        "OPF（privacy-filter）为 L2 内嵌第二检测器预接线（#127），GPU/Q4 机型就绪后开 l2.opf.enabled 即启用"
      ]
    }
  ]
}
